{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Maker Output Contract",
  "description": "Maker 产出的最小契约示例。按实际任务增删字段——契约先行,Checker 靠它判定。",
  "type": "object",
  "required": ["task_id", "produced_at", "content", "evidence"],
  "properties": {
    "task_id": {
      "type": "string",
      "description": "本轮任务唯一标识,与 STATE.md 中的幂等键一致"
    },
    "produced_at": {
      "type": "string",
      "format": "date-time",
      "description": "产出时间 ISO 8601"
    },
    "content": {
      "type": "object",
      "description": "任务的核心产物,结构按业务定义",
      "additionalProperties": true
    },
    "evidence": {
      "type": "array",
      "description": "支撑产出的证据条目;每条具体事实都应有对应条目",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim", "source"],
        "properties": {
          "claim": { "type": "string", "description": "被支撑的具体陈述" },
          "source": { "type": "string", "description": "可核实的来源(URL/文件路径/工具输出)" },
          "verified": { "type": "boolean", "description": "是否经过交叉验证" }
        }
      }
    }
  }
}
