{
  "name": "hermes-production-patterns",
  "version": "2.5.4",
  "description": "Production engineering patterns for Hermes Agent — linter, validator, and pattern library",
  "private": true,
  "bin": {
    "hpp-lint": "scripts/lint.js"
  },
  "scripts": {
    "lint": "node scripts/lint.js",
    "lint:fix": "node scripts/lint.js --fix",
    "test": "python -m pytest",
    "test:cov": "python -m pytest --cov --cov-report=term-missing",
    "test:behavior": "python scripts/run_regression.py",
    "validate": "python scripts/validate_state.py",
    "check:docs": "python scripts/check_docs_consistency.py",
    "check:suite": "python scripts/check_test_suite.py",
    "gate": "python cli/hpp.py audit . --fail-under 85"
  },
  "devDependencies": {
    "markdownlint-cli2": "^0.17.0"
  },
  "keywords": ["hermes", "agent", "production", "patterns", "linter"],
  "repository": {
    "type": "git",
    "url": "https://github.com/Komagon/hermes-production-patterns.git"
  },
  "license": "MIT"
}
